# ==========================================
# SOC Log Collector - Environment Configuration
# ==========================================

# Server Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./soc_collector.db

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Collector Configuration
COLLECTOR_SERVER_URL=http://localhost:8000/api/v1
COLLECTOR_ENROLLMENT_TOKEN=
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=60
COLLECTOR_BATCH_SIZE=20
COLLECTOR_LOCAL_QUEUE_FILE=./queue.jsonl
